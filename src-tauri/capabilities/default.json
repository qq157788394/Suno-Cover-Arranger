{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window (remote gh-pages in production)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-install-local-engine",
    "allow-get-engine-status",
    "allow-analyze-local-engine",
    "allow-prefetch-asset"
  ],
  "remote": { "urls": ["https://*.github.io"] }
}
